diff --git a/deploy/helm/openshell/tests/clusterrole_test.yaml b/deploy/helm/openshell/tests/clusterrole_test.yaml
index 309b10fc0e6b65b3425b4e248aafdd2817f6df74..9996062634227ba8c172b10747ea2d72b1805af4 100644
--- a/deploy/helm/openshell/tests/clusterrole_test.yaml
+++ b/deploy/helm/openshell/tests/clusterrole_test.yaml
@@ -221,3 +221,61 @@ tests:
       - equal:
           path: metadata.name
           value: openshell-node-reader-my-namespace
+
+  - it: grants only discovery for a file-backed operator workspace
+    set: &operatorDiscovery
+      rbac.clusterScoped.operatorDiscoveryNamespace: team-a
+      server.drivers.kubernetes.workspaceMode: operator
+      server.drivers.kubernetes.operatorNamespaceFile: /config/workspaces.json
+      server.defaultRuntimeClassName: sandboxed
+    asserts:
+      - equal:
+          path: rules
+          value:
+            - apiGroups: [""]
+              resources: ["namespaces"]
+              resourceNames: ["my-namespace", "team-a"]
+              verbs: ["get"]
+            - apiGroups: ["node.k8s.io"]
+              resources: ["runtimeclasses"]
+              resourceNames: ["sandboxed"]
+              verbs: ["get"]
+            - apiGroups: ["agents.x-k8s.io"]
+              resources: ["sandboxes"]
+              verbs: ["list", "watch"]
+            - apiGroups: ["authentication.k8s.io"]
+              resources: ["tokenreviews"]
+              verbs: ["create"]
+
+  - it: refuses discovery for a managed workspace
+    set:
+      <<: *operatorDiscovery
+      server.drivers.kubernetes.workspaceMode: managed
+    asserts:
+      - failedTemplate:
+          errorMessage: rbac.clusterScoped.operatorDiscoveryNamespace requires operator workspace mode with operator_namespace_file and no namespace label selector
+
+  - it: refuses namespace discovery by label
+    set:
+      <<: *operatorDiscovery
+      server.drivers.kubernetes.operatorNamespaceFile: ""
+      server.drivers.kubernetes.operatorNamespaceLabel: openshell.ai/workspace=true
+    asserts:
+      - failedTemplate:
+          errorMessage: rbac.clusterScoped.operatorDiscoveryNamespace requires operator workspace mode with operator_namespace_file and no namespace label selector
+
+  - it: refuses a wildcard workspace namespace
+    set:
+      <<: *operatorDiscovery
+      rbac.clusterScoped.operatorDiscoveryNamespace: "*"
+    asserts:
+      - failedTemplate:
+          errorMessage: rbac.clusterScoped.operatorDiscoveryNamespace must be a Kubernetes namespace name
+
+  - it: requires a named runtime class for discovery
+    set:
+      <<: *operatorDiscovery
+      server.defaultRuntimeClassName: ""
+    asserts:
+      - failedTemplate:
+          errorMessage: operator discovery requires a named default_runtime_class_name
